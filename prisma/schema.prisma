generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Status da OBRA
enum ObraStatus {
  ASSINATURA_DE_CONTRATO       @map("Assinatura de contrato")
  AGUARDANDO_VALIDACAO_TECNICA @map("Aguardando validação técnica")
  COMPRAS                      @map("Compras")
  A_INICIAR                    @map("À iniciar")
  EXECUCAO                     @map("Execução")
  AGUARDANDO_PAGAMENTO         @map("Aguardando pagamento")
  PENDENCIA                    @map("Pendência")
  FINALIZADO                   @map("Finalizado")
}

// Status genérico de pagamento
enum PagamentoStatus {
  PENDENTE @map("Pendente")
  EFETUADO @map("Efetuado")
}

// Status de TELHA/MADEIRA (iguais)
enum PedidoStatusPadrao {
  PENDENTE             @map("Pendente")
  AGUARDANDO_PAGAMENTO @map("Aguardando pagamento")
  PEDIDO_FEITO         @map("Pedido feito")
  ENTREGUE             @map("Entregue")
}

// Status de MATERIAIS
enum PedidoStatusMateriais {
  PENDENTE   @map("Pendente")
  EM_ESTOQUE @map("Em estoque")
  ENTREGUE   @map("Entregue")
}

// Status de ANDAIMES
enum PedidoStatusAndaimes {
  PENDENTE     @map("Pendente")
  PEDIDO_FEITO @map("Pedido feito")
  ENTREGUE     @map("Entregue")
  A_COLETAR    @map("À coletar")
  COLETADO     @map("Coletado")
}

model cidades {
  id      Int       @id @default(autoincrement())
  nome    String    @unique @db.VarChar(100)
  cliente cliente[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model cliente {
  id        Int         @id @default(autoincrement())
  nome      String      @db.VarChar(150)
  telefone  String?     @db.VarChar(20)
  bairro    String?     @db.VarChar(100)
  cidade_id Int?
  cpf       String?     @db.VarChar(11)
  cidades   cidades?    @relation(fields: [cidade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orcamento orcamento[]
  obras     obras[]

  @@index([cidade_id], map: "idx_cliente_cidade_id")
  @@index([nome], map: "idx_cliente_nome") // novo índice “normal” no nome
}

model componentes {
  id   Int    @id @default(autoincrement())
  nome String @unique
}

model frete {
  id     Int     @id @default(autoincrement())
  bairro String  @db.VarChar(100)
  preco  Decimal @db.Decimal(10, 2)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model materiais {
  id                Int              @id @default(autoincrement())
  descricao         String           @db.VarChar(150)
  tipo              String           @db.VarChar(20)
  preco_unitario    Decimal          @db.Decimal(10, 2)
  unidade_de_medida String?          @default("un") @db.VarChar(20)
  fornecedorId      Int?
  fornecedor        fornecedores?    @relation(fields: [fornecedorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  receitas_fixas    receitas_fixas[]

  @@unique([descricao, fornecedorId], map: "ux_materiais_desc_fornecedor")
  @@index([tipo])
  @@index([fornecedorId])
}

model fornecedores {
  id        Int         @id @default(autoincrement())
  nome      String      @unique @db.VarChar(120)
  tipo      String?     @db.VarChar(50)
  materiais materiais[]

  pedidosMadeira  pedido_compra[] @relation("FornecedorMadeira")
  pedidosAndaimes pedido_compra[] @relation("FornecedorAndaimes")
  pedidosTelha    pedido_compra[] @relation("FornecedorTelha")

  orcamentosFornecedor orcamento[] @relation("FornecedorOrcamentos")

  @@index([tipo])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model orcamento {
  id                    Int       @id @default(autoincrement())
  cliente_id            Int
  tipo_obra_id          Int?
  link_slide            String?   @db.VarChar(255)
  data_criacao          DateTime? @default(dbgenerated("(now() AT TIME ZONE 'America/Sao_Paulo'::text)")) @db.Timestamp(6)
  data_ultima_alteracao DateTime  @default(dbgenerated("(now() AT TIME ZONE 'America/Sao_Paulo'::text)")) @map("data_ultima_alteracao") @db.Timestamp(6)

  totais_madeiras_preco   Decimal       @default(0.00) @db.Decimal(10, 2)
  totais_materiais_preco  Decimal       @default(0.00) @db.Decimal(10, 2)
  totais_comissao_preco   Decimal       @default(0.00) @db.Decimal(10, 2)
  totais_empresa_ps_preco Decimal       @default(0.00) @db.Decimal(10, 2)
  totais_empresa_gd_preco Decimal       @default(0.00) @db.Decimal(10, 2)
  largura                 Decimal?      @db.Decimal(10, 2)
  comprimento             Decimal?      @db.Decimal(10, 2)
  totais_frete_preco      Decimal       @default(0.00) @db.Decimal(10, 2)
  link_pdf                String?
  titulo                  String?       @unique(map: "orcamento_titulo_unique") @db.VarChar(150)
  observacoes             String?       @db.Text
  excluido                Boolean       @default(false)
  // Fornecedor (madeira) opcional do orçamento
  id_fornecedor           Int?
  fornecedor              fornecedores? @relation("FornecedorOrcamentos", fields: [id_fornecedor], references: [id], onDelete: SetNull)

  largura_menor     Decimal?  @db.Decimal(10, 2)
  largura_maior     Decimal?  @db.Decimal(10, 2)
  comprimento_menor Decimal?  @db.Decimal(10, 2)
  comprimento_maior Decimal?  @db.Decimal(10, 2)
  lancado_obra      Boolean   @default(false)
  lancado_obra_em   DateTime?
  obra              obras?

  created_by Int?
  updated_by Int?

  createdBy User? @relation("OrcamentoCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedBy User? @relation("OrcamentoUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  cliente             cliente               @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipo_obra           tipo_obra?            @relation(fields: [tipo_obra_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orcamento_material  orcamento_material[]
  orcamento_pagamento orcamento_pagamento[]

  @@index([data_criacao(sort: Desc)], map: "idx_orcamento_data_criacao")
  @@index([data_ultima_alteracao(sort: Desc)], map: "idx_orcamento_data_ultima_alteracao")
  @@index([created_by], map: "idx_orcamento_created_by")
  @@index([updated_by], map: "idx_orcamento_updated_by")
  @@index([lancado_obra], map: "idx_orcamento_lancado_obra")
  @@index([id_fornecedor], map: "idx_orcamento_id_fornecedor")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orcamento_material {
  id             Int       @id @default(autoincrement())
  orcamento_id   Int
  material_id    Int?
  quantidade     Decimal   @db.Decimal(10, 2)
  preco_unitario Decimal   @db.Decimal(10, 2)
  tipo           String?
  descricao      String?
  tamanho        Decimal?  @db.Decimal(10, 2)
  componente     String?
  total          Decimal   @default(0.00) @db.Decimal(10, 2)
  frete          Decimal   @default(0.00) @db.Decimal(10, 2)
  orcamento      orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orcamento_id, id], map: "idx_orc_mat_orcamento_id_id")
}

model orcamento_pagamento {
  id               Int       @id @default(autoincrement())
  orcamento_id     Int
  tipo_telhas      String
  metodo_pagamento String
  valor            Decimal   @db.Decimal(10, 2)
  orcamento        orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orcamento_id], map: "idx_orcamento_pagamento_orcamento_id")
  @@index([orcamento_id, tipo_telhas, metodo_pagamento], map: "idx_orc_pag_orcamento_id_tipo_metodo")
}

model receitas_fixas {
  id          Int       @id @default(autoincrement())
  tipo_obra   String    @db.VarChar(100)
  material_id Int
  quantidade  Decimal   @db.Decimal(10, 2)
  componente  String?
  materiais   materiais @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model tipo_obra {
  id        Int         @id(map: "produto_pkey") @default(autoincrement())
  tipo_obra String
  orcamento orcamento[]
}

model User {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(150)
  email         String   @unique @db.VarChar(150)
  password_hash String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  roles UserRole[]

  orcamentosCriados     orcamento[] @relation("OrcamentoCreatedBy")
  orcamentosAtualizados orcamento[] @relation("OrcamentoUpdatedBy")

  obrasCriadas     obras[] @relation("ObraCreatedBy")
  obrasAtualizadas obras[] @relation("ObraUpdatedBy")

  auditLogs           AuditLog[] // <<< novo (back-relation)
  passwordResetTokens PasswordResetToken[] // <<< novo (back-relation)

  @@map("users")
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique @db.VarChar(50) // ex: 'ADMIN', 'DEV', 'VENDEDOR'
  label String     @db.VarChar(100) // ex: 'Administrador'
  users UserRole[]

  @@map("roles")
}

model UserRole {
  user_id Int
  role_id Int

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@map("user_roles")
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  user_id    Int? // null = ação de sistema
  action     String   @db.VarChar(60) // ex: 'ORCAMENTO_CREATE'
  entity     String   @db.VarChar(60) // ex: 'orcamento'
  entity_id  Int?
  detail     Json?
  ip         String?  @db.VarChar(64)
  user_agent String?
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([entity, entity_id])
  @@index([user_id, created_at])
  @@index([created_at])
  @@map("audit_log")
}

model pedido_compra {
  id Int @id @default(autoincrement())

  // 1:1 com Obra — cai se a obra cair
  obra_id Int   @unique
  obra    obras @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  // TELHA
  orcamento_telha     Decimal            @default(0) @db.Decimal(10, 2)
  previsao_telha      DateTime?          @db.Date
  status_telha        PedidoStatusPadrao @default(PENDENTE)
  area_telha          Decimal            @default(0) @db.Decimal(10, 2)
  fornecedor_telha_id Int?
  fornecedor_telha    fornecedores?      @relation("FornecedorTelha", fields: [fornecedor_telha_id], references: [id], onDelete: SetNull)

  // MADEIRA
  orcamento_madeira     Decimal            @default(0) @db.Decimal(10, 2)
  previsao_madeira      DateTime?          @db.Date
  status_madeira        PedidoStatusPadrao @default(PENDENTE)
  fornecedor_madeira_id Int?
  fornecedor_madeira    fornecedores?      @relation("FornecedorMadeira", fields: [fornecedor_madeira_id], references: [id], onDelete: SetNull)

  // MATERIAIS
  materiais_status PedidoStatusMateriais @default(PENDENTE)

  // ANDAIMES
  andaimes_status        PedidoStatusAndaimes @default(PENDENTE)
  andaimes_fornecedor_id Int?
  andaimes_fornecedor    fornecedores?        @relation("FornecedorAndaimes", fields: [andaimes_fornecedor_id], references: [id], onDelete: SetNull)

  // LINKS 1–1 (opcionais e únicos)
  pedido_telha_id     Int? @unique
  pedido_madeira_id   Int? @unique
  pedido_materiais_id Int? @unique
  pedido_andaimes_id  Int? @unique

  // Relações 1–1 nomeadas (back-fields nos itens)
  pedido_telha_link     pedido_telha?     @relation("PC_to_PT_Link", fields: [pedido_telha_id], references: [id])
  pedido_madeira_link   pedido_madeira?   @relation("PC_to_PM_Link", fields: [pedido_madeira_id], references: [id])
  pedido_materiais_link pedido_materiais? @relation("PC_to_PMat_Link", fields: [pedido_materiais_id], references: [id])
  pedido_andaimes_link  pedido_andaimes?  @relation("PC_to_PA_Link", fields: [pedido_andaimes_id], references: [id])

  // Coleções 1–N — caem se o pedido cair
  pedido_telha_itens     pedido_telha[]     @relation("PC_to_PT_Items")
  pedido_madeira_itens   pedido_madeira[]   @relation("PC_to_PM_Items")
  pedido_materiais_itens pedido_materiais[] @relation("PC_to_PMat_Items")
  pedido_andaimes_itens  pedido_andaimes[]  @relation("PC_to_PA_Items")

  @@index([obra_id])
  @@index([fornecedor_telha_id])
  @@index([fornecedor_madeira_id])
  @@index([andaimes_fornecedor_id])
}

model ordem_servico {
  id                  Int      @id @default(autoincrement())
  equipe_id           Int
  data_prev_inicio    DateTime @db.Date
  data_prev_conclusao DateTime @db.Date

  // 1:1 com Obra — cai se a obra cair
  obra_id Int   @unique
  obra    obras @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  // equipe permanece se OS cair
  equipe equipes @relation(fields: [equipe_id], references: [id])

  @@index([equipe_id])
  @@index([obra_id])
}

model equipes {
  id   Int    @id @default(autoincrement())
  nome String @db.VarChar(120)

  ordem_servico ordem_servico[]
  obras         obras[]
}

model pedido_telha {
  id               Int     @id @default(autoincrement())
  pedido_compra_id Int
  descricao        String  @db.VarChar(150)
  quantidade       Decimal @db.Decimal(10, 2)
  preco_unitario   Decimal @db.Decimal(10, 2)
  total            Decimal @db.Decimal(10, 2)

  // Itens (1:N) — caem se o pedido cair
  pedido_compra      pedido_compra  @relation("PC_to_PT_Items", fields: [pedido_compra_id], references: [id], onDelete: Cascade)
  // “Link” 1:1 (back-field do head)
  pedido_compra_link pedido_compra? @relation("PC_to_PT_Link")

  @@index([pedido_compra_id])
}

model pedido_madeira {
  id               Int     @id @default(autoincrement())
  pedido_compra_id Int
  componente       String  @db.VarChar(100)
  madeira_nome     String  @db.VarChar(120)
  descricao        String  @db.VarChar(150)
  quantidade       Decimal @db.Decimal(10, 2)
  tamanho          Decimal @db.Decimal(10, 2)
  preco_unitario   Decimal @db.Decimal(10, 2)
  total            Decimal @db.Decimal(10, 2)

  pedido_compra      pedido_compra  @relation("PC_to_PM_Items", fields: [pedido_compra_id], references: [id], onDelete: Cascade)
  pedido_compra_link pedido_compra? @relation("PC_to_PM_Link")

  @@index([pedido_compra_id])
}

model pedido_materiais {
  id               Int     @id @default(autoincrement())
  pedido_compra_id Int
  descricao        String  @db.VarChar(150)
  quantidade       Decimal @db.Decimal(10, 2)
  preco_unitario   Decimal @db.Decimal(10, 2)
  total            Decimal @db.Decimal(10, 2)

  pedido_compra      pedido_compra  @relation("PC_to_PMat_Items", fields: [pedido_compra_id], references: [id], onDelete: Cascade)
  pedido_compra_link pedido_compra? @relation("PC_to_PMat_Link")

  @@index([pedido_compra_id])
}

model pedido_andaimes {
  id               Int     @id @default(autoincrement())
  pedido_compra_id Int
  descricao        String  @db.VarChar(150)
  quantidade       Decimal @db.Decimal(10, 2)
  preco_unitario   Decimal @db.Decimal(10, 2)
  total            Decimal @db.Decimal(10, 2)

  pedido_compra      pedido_compra  @relation("PC_to_PA_Items", fields: [pedido_compra_id], references: [id], onDelete: Cascade)
  pedido_compra_link pedido_compra? @relation("PC_to_PA_Link")

  @@index([pedido_compra_id])
}

model obras {
  id Int @id @default(autoincrement())

  // 1:1 com Orçamento (mantém a obra se o orçamento cair)
  orcamento_id Int?       @unique
  orcamento    orcamento? @relation(fields: [orcamento_id], references: [id], onDelete: SetNull)

  // N:1 com Cliente (cliente permanece se a obra cair)
  cliente_id Int
  cliente    cliente @relation(fields: [cliente_id], references: [id])

  // N:1 com Equipe (mantém a obra se a equipe cair)
  equipe_id Int?
  equipe    equipes? @relation(fields: [equipe_id], references: [id], onDelete: SetNull)

  // 1:1 com Ordem de Serviço — FK fica no filho (ordem_servico)
  ordem_servico ordem_servico?

  // 1:1 com Pedido de Compra — FK fica no filho (pedido_compra)
  pedido_compra pedido_compra?

  // NOVO — título espelho do orçamento (igual ao orcamento.titulo)
  titulo String? @db.VarChar(150)

  // CAMPOS
  endereco_obra   String  @db.VarChar(255)
  maps_url        String  @db.VarChar(255)
  tipo_obra       String  @db.VarChar(100)
  largura         Decimal @db.Decimal(10, 2)
  comprimento     Decimal @db.Decimal(10, 2)
  telha_escolhida String  @db.VarChar(120)

  valor_obra        Decimal @db.Decimal(10, 2)
  valor_mao_de_obra Decimal @db.Decimal(10, 2)

  status      ObraStatus @default(ASSINATURA_DE_CONTRATO)
  observacoes String?    @db.Text

  // Financeiro
  pagamento_entrada        Decimal?        @db.Decimal(10, 2)
  forma_pagamento_entrada  String?         @db.VarChar(30)
  status_pagamento_entrada PagamentoStatus @default(PENDENTE)

  pagamento_quitacao        Decimal?        @db.Decimal(10, 2)
  forma_pagamento_quitacao  String?         @db.VarChar(30)
  status_pagamento_quitacao PagamentoStatus @default(PENDENTE)

  // ANEXOS
  link_slide_orcamento String? @db.VarChar(255)
  link_pdf_orcamento   String? @db.VarChar(255)
  link_contrato        String? @db.VarChar(255)
  link_ordem_servico   String? @db.VarChar(255)

  // Auditoria
  created_by Int?
  updated_by Int?
  createdBy  User? @relation("ObraCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedBy  User? @relation("ObraUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  data_criacao          DateTime? @default(dbgenerated("(now() AT TIME ZONE 'America/Sao_Paulo'::text)")) @db.Timestamp(6)
  data_ultima_alteracao DateTime  @default(dbgenerated("(now() AT TIME ZONE 'America/Sao_Paulo'::text)")) @updatedAt @map("data_ultima_alteracao") @db.Timestamp(6)

  // Imagens 1:N — caem junto com a obra
  imagens obra_imagens[]

  @@index([cliente_id])
  @@index([equipe_id])
  @@index([created_by])
  @@index([updated_by])
  @@index([titulo], map: "idx_obras_titulo")
}

model obra_imagens {
  id         Int      @id @default(autoincrement())
  obra_id    Int
  url        String   @db.VarChar(500)
  ordem      Int?
  legenda    String?
  created_at DateTime @default(now())

  obra obras @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
}
